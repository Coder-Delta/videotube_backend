PORT=8000
# MongoDB URI format: mongodb+srv://username:password@cluster.mongodb.net/
# Make sure to include your username and password!
# Example: mongodb+srv://admin:myPassword123@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

CORS_ORIGIN=*

# JWT Tokens
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_min_32_chars
ACCESS_TOKEN_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_min_32_chars
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=